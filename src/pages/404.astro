---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="404 - iindev" noindex>
  <section class="works-hero">
    <div class="l-wrapper">
      <span class="works-label">404</span>
      <h1 class="works-title">Страница не найдена</h1>
      <p class="works-desc">Возможно, она ещё не запущена. А может, мы её и не делали.</p>
      <p style="margin-top:2rem;">
        <a href="/" class="btn-primary">На главную <span class="btn-arrow">↗</span></a>
      </p>
    </div>
  </section>
</BaseLayout>
