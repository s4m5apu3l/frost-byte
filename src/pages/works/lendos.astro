---
import BaseLayout from '@layouts/BaseLayout.astro';
import { lendosProjects } from '@/data/projects';
---

<BaseLayout
  title="Работы iindev lendos - Лендинги с любым прайсом"
  description="Сайты, которые мы создали. Каждый запущен и работает. Демо-сайты для малого бизнеса с оплатой за результат."
>
  <section class="works-hero">
    <div class="l-wrapper">
      <span class="works-label">iindev lendos</span>
      <h1 class="works-title">Работы</h1>
      <p class="works-desc">Сайты, которые мы создали. Каждый запущен и работает.</p>
    </div>
  </section>

  <section class="works-philosophy">
    <div class="l-wrapper">
      <span class="works-label">Философия</span>
      <div class="works-philosophy-text">
        <p>Студии берут предоплату за обещание. Мы берём оплату за результат.</p>
        <p>Сначала делаем. Потом вы решаете, сколько это стоит. Если не стоит - не платите.</p>
        <p>Это не щедрость. Это стандарт, до которого рынок ещё не дошёл.</p>
      </div>
    </div>
  </section>

  <section class="works-grid-section">
    <div class="l-wrapper">
      <div class="works-grid" id="worksGrid">
        {lendosProjects.map((lp) => (
          <a href={lp.url} class="works-card" target="_blank" rel="noopener">
            <div class="works-card-mockup">
              {lp.image ? (
                <img src={lp.image} alt={lp.name} class="works-card-screenshot" loading="lazy" />
              ) : (
                <div class="work-card-mockup">
                  <div class="mockup-bar"><span></span><span></span><span></span></div>
                  <div class="mockup-content">
                    <div class="mockup-nav"></div>
                    <div class="mockup-hero"></div>
                    <div class="mockup-blocks">
                      <div class="mockup-block"></div>
                      <div class="mockup-block"></div>
                    </div>
                  </div>
                </div>
              )}
            </div>
            <div class="works-card-info">
              <h3 class="works-card-name">{lp.name}</h3>
              <span class="works-card-type">{lp.desc}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
