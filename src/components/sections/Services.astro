---
const cards = [
  {
    num: '01',
    title: 'Веб-разработка',
    text: 'Лендинги, корпоративные сайты, магазины. AI-ускорение дает сроки в 2-4 недели без потери качества.',
    list: ['Лендинги и промо', 'Корпоративные сайты', 'Интернет-магазины', 'Битрикс · WordPress · Тильда'],
  },
  {
    num: '02',
    title: 'AI и автоматизация',
    text: 'Интеграция AI-ассистентов, сценарии автоматизации, CRM-настройки. Экономия часов вашей команды.',
    list: ['AI-ассистенты', 'CRM-автоматизация', 'Роботизация процессов', 'Интеграции с 1С'],
  },
  {
    num: '03',
    title: 'SEO и аналитика',
    text: 'Скорость, структура, контент. Выводим в топ поисковых систем и удерживаем позиции.',
    list: ['Технический SEO-аудит', 'Семантическое ядро', 'Контент-стратегия', 'Яндекс · Google аналитика'],
  },
  {
    num: '04',
    title: 'Telegram боты',
    text: 'Боты для продаж, поддержки, внутренних процессов. Mini Apps и интеграции с вашими системами.',
    list: ['Боты продаж и поддержки', 'Mini Apps', 'Уведомления и рассылки', 'Интеграции с API'],
  },
];
---

<section class="services" id="services">
  <div class="services-inner">
    <div class="services-intro">
      <span class="services-label">Услуги</span>
      <h2 class="services-title">
        <span class="services-line">Все под одной крышей.</span>
        <span class="services-line">Без бюрократии и задержек.</span>
      </h2>
    </div>
    <div class="services-track-wrapper">
      <div class="services-track">
        {cards.map((c) => (
          <div class="services-card">
            <span class="services-card-ghost">{c.num}</span>
            <div class="services-card-content">
              <div>
                <h3 class="services-card-title">{c.title}</h3>
                <p class="services-card-text">{c.text}</p>
                <ul class="services-card-list">
                  {c.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <a href="#contact" class="services-card-link">Обсудить проект <span class="services-card-arrow">↗</span></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
