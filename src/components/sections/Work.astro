---
import { projects } from '@/data/projects';
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="l-wrapper">
    <div class="work-header">
      <h2 class="work-title" id="work-title">Наши проекты</h2>
    </div>
    <div class="work-bento">
      {projects.map((p) => (
        <div class="work-card work-card-large work-card-project" data-project={p.id}>
          {(p.mockup || p.image) && (
            <div class="work-card-image">
              <div class="work-card-image-inner">
                {p.image ? (
                  <img src={p.image} alt={p.label} class="work-card-screenshot" loading="lazy" />
                ) : (
                  <div class="work-card-mockup">
                    <div class="mockup-bar"><span></span><span></span><span></span></div>
                    <div class="mockup-content">
                      <div class="mockup-nav"></div>
                      <div class="mockup-hero"></div>
                      <div class="mockup-blocks">
                        <div class="mockup-block"></div>
                        <div class="mockup-block"></div>
                        <div class="mockup-block mockup-block-short"></div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}
          <div class="work-card-bg"></div>
          <div class="work-card-inner">
            <span class="work-card-label">{p.accentLabel ? <><span class="accent">{p.accentLabel}</span> {p.label}</> : p.label}</span>
            <span class="work-card-sublabel">{p.sublabel}</span>
            <span class="work-card-badge">{p.badge}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
