---
const steps = [
  { num: '01', title: 'Запрос', text: 'Вникаем в задачу за 30 минут. Проблемы, цели, аудитория - всё фиксируем и берёмся за работу.' },
  { num: '02', title: 'Прототип', text: 'Собираем рабочий прототип. Вы трогаете, нажимаете, утверждаете. Не картинки - живой сайт.' },
  { num: '03', title: 'Разработка', text: 'Пишем чистый код. Каждые 2-3 дня показываем прогресс. Вы видите как растёт сайт.' },
  { num: '04', title: 'Финал', text: 'Ваш код. Ваши доступы. Ваш домен. Полностью ваш. Но мы рядом, если нужно.' },
];
---

<section class="process" id="process" aria-labelledby="process-title">
  <div class="l-wrapper">
    <div class="process-header">
      <span class="process-label">Процесс</span>
      <h2 class="process-title" id="process-title">От идеи до запуска</h2>
    </div>
    <div class="process-track">
      {steps.map((s, i) => (
        <div class="process-step">
          <span class="process-step-num">{s.num}</span>
          <div class="process-step-content">
            <h3 class="process-step-title">{s.title}</h3>
            <p class="process-step-text">{s.text}</p>
          </div>
          {i < steps.length - 1 && <span class="process-step-arrow">→</span>}
        </div>
      ))}
    </div>
  </div>
</section>
