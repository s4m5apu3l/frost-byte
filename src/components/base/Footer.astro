---
import { SITE } from '@/consts';
---

<footer class="footer">
  <div class="footer-card">
    <div class="footer-ambient">
      <div class="footer-orb footer-orb-1"></div>
      <div class="footer-orb footer-orb-2"></div>
    </div>
    <div class="footer-inner">
      <div class="footer-main">
        <div class="footer-brand">
          <a href="/" class="footer-logo">iind<span class="ev">ev</span></a>
          <p class="footer-brand-desc">
            Студия, которая делает быстрее остальных,
            без срезания углов. Веб, AI, автоматизация.
            Все внутри.
          </p>
        </div>
        <div class="footer-links">
          <div class="footer-links-col">
            <span class="footer-links-title">Услуги</span>
            <a href="/#services" class="footer-link">Веб-разработка</a>
            <a href="/#services" class="footer-link">AI и автоматизация</a>
            <a href="/#services" class="footer-link">SEO</a>
            <a href="/#services" class="footer-link">Telegram боты</a>
          </div>
          <div class="footer-links-col">
            <span class="footer-links-title">Компания</span>
            <a href="/#about" class="footer-link">О нас</a>
            <a href="/#work" class="footer-link">Работы</a>
            <a href="/#contact" class="footer-link">Контакты</a>
          </div>
          <div class="footer-links-col">
            <span class="footer-links-title">Связь</span>
            <a href={SITE.telegram} class="footer-link">Telegram</a>
            <a href={`mailto:${SITE.email}`} class="footer-link">Email</a>
          </div>
          <div class="footer-links-col">
            <span class="footer-links-title">Документы</span>
            <a href="/legal/privacy" class="footer-link">Конфиденциальность</a>
            <a href="/legal/terms" class="footer-link">Соглашение</a>
            <a href="/legal/consent" class="footer-link">Согласие на ПД</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span class="footer-copyright">&copy; <span class="year">{new Date().getFullYear()}</span> <span class="accent">iind</span>ev</span>
        <a href={`mailto:${SITE.email}`} class="footer-email">{SITE.email}</a>
      </div>
    </div>
  </div>
</footer>
