---
import '@/styles/global.css';
import Head from '@components/base/Head.astro';
import Header from '@components/base/Header.astro';
import Loader from '@components/base/Loader.astro';
import Cursor from '@components/base/Cursor.astro';
import Slideover from '@components/base/Slideover.astro';
import Footer from '@components/base/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const { ...seo } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <Head {...seo} />
  </head>
  <body class="is-loading" aria-busy="true">
    <Loader />
    <Cursor />
    <slot name="hero-loader" />
    <Header />
    <main>
      <slot />
    </main>
    <Slideover />
    <Footer />
    <div class="toast" id="toast" transition:persist>
      <svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span class="toast-text" id="toast-text"></span>
    </div>

    <script>
      import { initCursor } from '@scripts/cursor';
      import { initBurger } from '@scripts/burger';
      import { initLoader, initTransitionHandlers } from '@scripts/loader';
      import { initHeroAnimations, initScrollAnimations, killScrollTriggers } from '@scripts/animations';

      const w = window as any;
      if (!w.__iindev) w.__iindev = {};
      const state = w.__iindev;

      if (!state.showToast) {
        state.showToast = (msg: string) => {
          const el = document.getElementById('toast');
          const text = document.getElementById('toast-text');
          if (!el || !text) return;
          text.textContent = msg;
          el.classList.remove('hide');
          el.classList.add('show');
          setTimeout(() => {
            el.classList.remove('show');
            el.classList.add('hide');
          }, 3000);
        };
      }

      function runPageAnimations() {
        initHeroAnimations();
        initScrollAnimations();
      }

      function boot() {
        if (!state.once) {
          state.once = true;
          document.documentElement.classList.add('skip-loader');
          window.scrollTo(0, 0);
          initCursor();
          initBurger();
          initTransitionHandlers();
          document.querySelectorAll('.year').forEach((el) => {
            el.textContent = String(new Date().getFullYear());
          });
        }
        if (!state.loaderInited) {
          state.loaderInited = true;
          initLoader(() => {
            runPageAnimations();
          });
        } else {
          killScrollTriggers();
          runPageAnimations();
        }
      }

      if (!state.listener) {
        state.listener = true;
        document.addEventListener('astro:page-load', boot);
      }
    </script>
  </body>
</html>
